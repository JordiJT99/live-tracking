{
    "name": "live-tracking/simulator",
    "description": "Live Tracking — DDD GPS simulation microservice (PHP 8.4 + ReactPHP)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "react/http": "^1.9",
        "react/event-loop": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Simulator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simulator\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
